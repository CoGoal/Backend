 <changeSet id="002-bigint-profiles" author="cogoal">
  <renameTable oldTableName="user_profiles" newTableName="legacy_user_profiles"/>
  <createTable tableName="user_profiles">
   <column name="id" type="BIGINT"><constraints primaryKey="true" primaryKeyName="pk_bigint_user_profiles" nullable="false"/></column>
   <column name="legacy_id" type="UUID"><constraints unique="true" uniqueConstraintName="uq_bigint_profile_legacy"/></column>
   <column name="email" type="VARCHAR(255)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_bigint_profile_email"/></column>
   <column name="username" type="VARCHAR(32)"><constraints nullable="false"/></column>
   <column name="username_key" type="VARCHAR(32)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_bigint_profile_username"/></column>
   <column name="name" type="VARCHAR(100)"><constraints nullable="false"/></column>
   <column name="avatar_url" type="VARCHAR(2048)"/>
   <column name="role" type="VARCHAR(20)"><constraints nullable="false"/></column>
   <column name="coins" type="INT"><constraints nullable="false"/></column>
   <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
   <column name="profile_version" type="BIGINT"><constraints nullable="false"/></column>
  </createTable>
  <createTable tableName="profile_sync_locks">
