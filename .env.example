JWT_SECRET=replace-with-random-secret-at-least-32-characters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Optional external PostgreSQL, independently for each service.
# Leave these empty for local PostgreSQL. Neon requires TLS; keep passwords out of URLs.
MAIN_DB_URL=
MAIN_DB_USERNAME=
MAIN_DB_PASSWORD=
AUTH_DB_URL=
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
# For Neon, set these after configuring both database connections:
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.neon.yml
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_CONTEXT=./Frontend
FRONTEND_PORT=5173
INITIAL_COINS=100
KAFKA_PROFILE_TOPIC=cogoal.user-profiles.v1
KAFKA_PROFILE_GROUP=cogoal-main-profiles-v1
# Local SMTP uses Mailpit; configure these variables for an external SMTP server.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@cogoal.local
# Optional first administrator; leave email/password empty to disable creation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
