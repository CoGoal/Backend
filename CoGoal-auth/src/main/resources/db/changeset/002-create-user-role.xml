<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="002-create-user-role" author="dev">
        <createTable tableName="user_role">
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <!-- без префикса ROLE_: USER, ADMIN -->
            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_role" columnNames="user_id, role" constraintName="pk_user_role"/>

        <addForeignKeyConstraint constraintName="fk_user_role_user"
                                 baseTableName="user_role" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
