<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!-- id генерирует приложение: это тот же UUID, что sub в токене и users.id в main -->
    <changeSet id="001-create-users" author="dev">
        <createTable tableName="users">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_users" nullable="false"/>
            </column>
            <!-- хранится в нижнем регистре -->
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_users_email"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="failed_login_attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>ALTER TABLE users ADD CONSTRAINT ck_users_email_lower CHECK (email = lower(email))</sql>

        <!-- username уникален без учёта регистра: "Alice" и "alice" — один и тот же -->
        <sql>CREATE UNIQUE INDEX uq_users_username_lower ON users (lower(username))</sql>
    </changeSet>
</databaseChangeLog>
