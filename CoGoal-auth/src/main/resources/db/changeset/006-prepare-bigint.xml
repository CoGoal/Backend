<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
 <changeSet id="006-prepare-bigint" author="cogoal">
  <preConditions onFail="HALT">
   <sqlCheck expectedResult="0">SELECT count(*) FROM users WHERE username !~ '^[a-zA-Z0-9_]{3,32}$'</sqlCheck>
  </preConditions>
  <renameTable oldTableName="users" newTableName="legacy_users"/>
  <renameTable oldTableName="user_role" newTableName="legacy_user_role"/>
  <renameTable oldTableName="refresh_token" newTableName="legacy_refresh_token"/>
  <renameTable oldTableName="account_action_token" newTableName="legacy_account_action_token"/>
 </changeSet>
</databaseChangeLog>
